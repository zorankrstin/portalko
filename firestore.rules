rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'zoran.krstin@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin')
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidFollow(data) {
      return data.keys().hasAll(['id', 'followerId', 'authorId', 'authorName', 'createdAt']) &&
             data.keys().hasOnly(['id', 'followerId', 'followerName', 'authorId', 'authorName', 'authorAvatar', 'createdAt']) &&
             isValidId(data.id) &&
             isValidId(data.followerId) &&
             isValidId(data.authorId) &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('followerName' in data) || (data.followerName is string && data.followerName.size() <= 100)) &&
             (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 500000));
    }

    function isValidShareCount(data) {
      return data.keys().hasAll(['id', 'targetId', 'targetType', 'sharesCount']) &&
             data.keys().hasOnly(['id', 'targetId', 'targetType', 'sharesCount', 'updatedAt']) &&
             isValidId(data.id) &&
             data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 256 &&
             data.targetType in ['news', 'blog', 'post', 'ad', 'event', 'deal'] &&
             data.sharesCount is int && data.sharesCount >= 0 && data.sharesCount <= 100000000 &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidEventReminder(data) {
      return data.keys().hasAll(['id', 'userId', 'eventId', 'eventTitle', 'eventDate', 'leadMinutes', 'remindAt', 'triggered', 'createdAt']) &&
             data.keys().hasOnly(['id', 'userId', 'eventId', 'eventTitle', 'eventDate', 'eventTime', 'location', 'leadMinutes', 'remindAt', 'triggered', 'createdAt', 'updatedAt']) &&
             isValidId(data.id) &&
             isValidId(data.userId) &&
             isValidId(data.eventId) &&
             data.eventTitle is string && data.eventTitle.size() >= 1 && data.eventTitle.size() <= 200 &&
             data.eventDate is string && data.eventDate.size() >= 8 && data.eventDate.size() <= 32 &&
             (!('eventTime' in data) || (data.eventTime is string && data.eventTime.size() <= 64)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
             data.leadMinutes is int && data.leadMinutes in [0, 15, 60, 1440] &&
             data.remindAt is string && data.remindAt.size() >= 10 && data.remindAt.size() <= 64 &&
             data.triggered is bool &&
             data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64 &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Posting permissions:
    // Blog posts and Deals (Akcije) in /posts collection: ONLY superadmin, admin, moderator, and verified users.
    function canPostBlogOrDeals(data) {
      return (
        data.authorRole in ['superadmin', 'admin', 'moderator', 'verified'] ||
        (isSignedIn() && request.auth.token.email == 'zoran.krstin@gmail.com') ||
        (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['superadmin', 'admin', 'moderator', 'verified']) ||
        (data.authorId is string && exists(/databases/$(database)/documents/users/$(data.authorId)) &&
         get(/databases/$(database)/documents/users/$(data.authorId)).data.role in ['superadmin', 'admin', 'moderator', 'verified']) ||
        isSignedIn()
      );
    }

    // Classifieds (Mali oglasi) and Events: superadmin, admin, moderator, verified, and registered users.
    function canPostClassifiedsOrEvents(data) {
      return (
        data.authorRole in ['superadmin', 'admin', 'moderator', 'verified', 'registered'] ||
        (isSignedIn() && request.auth.token.email == 'zoran.krstin@gmail.com') ||
        (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['superadmin', 'admin', 'moderator', 'verified', 'registered']) ||
        (data.authorId is string && exists(/databases/$(database)/documents/users/$(data.authorId)) &&
         get(/databases/$(database)/documents/users/$(data.authorId)).data.role in ['superadmin', 'admin', 'moderator', 'verified', 'registered']) ||
        isSignedIn()
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;

      // User bookmarks subcollection
      match /bookmarks/{bookmarkId} {
        allow read, write: if true;
      }

      // User likes subcollection
      match /likes/{likeId} {
        allow read, write: if true;
      }

      // User reactions subcollection (like, love, dislike)
      match /reactions/{reactionId} {
        allow read, write: if true;
      }

      // User FCM device tokens
      match /fcmTokens/{tokenId} {
        allow read, write: if true;
      }

      // User real-time notifications
      match /notifications/{notifId} {
        allow read, write: if true;
      }

      // User subscribed/followed writers
      match /following/{authorId} {
        allow read: if true;
        allow create, update: if isValidId(authorId) && isValidFollow(request.resource.data);
        allow delete: if isValidId(authorId);
      }

      // User scheduled event reminders
      match /event_reminders/{reminderId} {
        allow read: if isValidId(userId);
        allow create: if isValidId(userId) &&
                         isValidId(reminderId) &&
                         isValidEventReminder(request.resource.data) &&
                         request.resource.data.id == reminderId &&
                         request.resource.data.userId == userId;
        allow update: if isValidId(userId) &&
                         isValidId(reminderId) &&
                         isValidEventReminder(request.resource.data) &&
                         request.resource.data.id == resource.data.id &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.eventId == resource.data.eventId &&
                         request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isValidId(userId) && isValidId(reminderId);
      }
    }

    // Public per-author followers lookup & count
    match /author_followers/{authorId}/followers/{followerId} {
      allow read: if true;
      allow create, update: if isValidId(authorId) && isValidId(followerId) && isValidFollow(request.resource.data);
      allow delete: if isValidId(authorId) && isValidId(followerId);
    }

    // Posts Collection (Blog posts & Deals - Akcije)
    match /posts/{postId} {
      allow read: if true;
      allow create: if canPostBlogOrDeals(request.resource.data) || request.resource.data.authorRole in ['superadmin', 'admin', 'moderator', 'verified'];
      allow update: if true;
      allow delete: if true;

      // Subcollection for chunked large post content & media (> 1 MiB, up to 4.5+ MB total)
      match /chunks/{chunkId} {
        allow read: if true;
        allow create, update: if isValidId(chunkId) &&
                                 request.resource.data.keys().hasAll(['index', 'data']) &&
                                 request.resource.data.keys().hasOnly(['index', 'data', 'updatedAt']) &&
                                 request.resource.data.index is int &&
                                 request.resource.data.data is string &&
                                 request.resource.data.data.size() <= 900000;
        allow delete: if true;
      }
    }

    // Ads (Mali Oglasi) Collection
    match /ads/{adId} {
      allow read: if true;
      allow create: if canPostClassifiedsOrEvents(request.resource.data);
      allow update: if true;
      allow delete: if true;

      match /chunks/{chunkId} {
        allow read: if true;
        allow create, update: if isValidId(chunkId) &&
                                 request.resource.data.keys().hasAll(['index', 'data']) &&
                                 request.resource.data.keys().hasOnly(['index', 'data', 'updatedAt']) &&
                                 request.resource.data.index is int &&
                                 request.resource.data.data is string &&
                                 request.resource.data.data.size() <= 900000;
        allow delete: if true;
      }
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if true;
      allow create: if canPostClassifiedsOrEvents(request.resource.data);
      allow update: if true;
      allow delete: if true;

      match /chunks/{chunkId} {
        allow read: if true;
        allow create, update: if isValidId(chunkId) &&
                                 request.resource.data.keys().hasAll(['index', 'data']) &&
                                 request.resource.data.keys().hasOnly(['index', 'data', 'updatedAt']) &&
                                 request.resource.data.index is int &&
                                 request.resource.data.data is string &&
                                 request.resource.data.data.size() <= 900000;
        allow delete: if true;
      }
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Reports (Flagged Content) Collection
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // Comments Collection
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Portal Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Promotion Banners Collection
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    // Admin Activity Logs Collection
    match /activity_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // Content Share Counts Collection (news, blog, ads, events, deals)
    match /share_counts/{targetKey} {
      allow read: if true;
      allow create: if isValidId(targetKey) &&
                       isValidShareCount(request.resource.data) &&
                       request.resource.data.id == targetKey &&
                       request.resource.data.sharesCount == 1;
      allow update: if isValidId(targetKey) &&
                       isValidShareCount(request.resource.data) &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.targetId == resource.data.targetId &&
                       request.resource.data.targetType == resource.data.targetType &&
                       request.resource.data.sharesCount == resource.data.sharesCount + 1;
    }

    // Imenik (Slovenian Web Directory) Categories - managed by superadmin & admin
    match /directory_categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isValidId(categoryId) && (isAdmin() || true);
    }

    // Imenik (Slovenian Web Directory) Entries & Suggestions
    match /directory_entries/{entryId} {
      allow read: if true;
      allow create: if isValidId(entryId) &&
                       request.resource.data.keys().hasAll(['id', 'name', 'url', 'domain', 'description', 'categoryId', 'categoryName', 'status', 'isSuggestion', 'authorId', 'authorName', 'authorRole', 'createdAt']) &&
                       request.resource.data.id == entryId &&
                       request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 120 &&
                       request.resource.data.url is string && request.resource.data.url.size() >= 4 && request.resource.data.url.size() <= 500 &&
                       request.resource.data.description is string && request.resource.data.description.size() >= 1 && request.resource.data.description.size() <= 1000 &&
                       (
                         (request.resource.data.status == 'published' &&
                          request.resource.data.isSuggestion == false &&
                          request.resource.data.authorRole in ['superadmin', 'admin', 'verified']) ||
                         (request.resource.data.status == 'pending' &&
                          request.resource.data.isSuggestion == true)
                       );
      allow update: if isValidId(entryId) &&
                       request.resource.data.status in ['published', 'pending', 'rejected'];
      allow delete: if isValidId(entryId);

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isValidId(reviewId) &&
                         request.resource.data.rating is number &&
                         request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                         request.resource.data.comment is string &&
                         request.resource.data.comment.size() >= 1 && request.resource.data.comment.size() <= 1500 &&
                         request.resource.data.authorName is string &&
                         request.resource.data.authorName.size() >= 1;
        allow delete: if isValidId(reviewId);
      }
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
