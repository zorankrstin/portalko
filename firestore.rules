rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'zoran.krstin@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin')
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAllowedPoster(data) {
      return (data.authorRole in ['superadmin', 'admin', 'verified', 'registered']) || isSignedIn();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;

      // User bookmarks subcollection
      match /bookmarks/{bookmarkId} {
        allow read, write: if true;
      }
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAllowedPoster(request.resource.data);
      allow update: if true;
      allow delete: if true;
    }

    // Ads (Mali Oglasi) Collection
    match /ads/{adId} {
      allow read: if true;
      allow create: if isAllowedPoster(request.resource.data);
      allow update: if true;
      allow delete: if true;
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAllowedPoster(request.resource.data);
      allow update: if true;
      allow delete: if true;
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Reports (Flagged Content) Collection
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // Portal Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
