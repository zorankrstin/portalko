{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Portalko registered user profile and role mapping",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["superadmin", "admin", "verified", "registered", "guest"] },
        "status": { "type": "string", "enum": ["active", "banned", "pending_verification"] },
        "emailVerified": { "type": "boolean" },
        "verificationToken": { "type": "string", "maxLength": 256 },
        "verificationSentAt": { "type": "string" },
        "avatar": { "type": "string", "maxLength": 500000 },
        "bio": { "type": "string", "maxLength": 2000 },
        "username": { "type": "string", "maxLength": 50 },
        "socialLinks": { "type": "array" },
        "profileMenu": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "status"]
    },
    "Post": {
      "title": "Community Post or Blog",
      "description": "Article, blog or news post published on Portalko",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 3, "maxLength": 200 },
        "content": { "type": "string", "minLength": 5, "maxLength": 4500000 },
        "category": { "type": "string", "maxLength": 50 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorRole": { "type": "string", "maxLength": 50 },
        "authorAvatar": { "type": "string", "maxLength": 500000 },
        "imageUrl": { "type": "string", "maxLength": 4500000 },
        "images": { "type": "array" },
        "attachments": { "type": "array", "description": "Firebase Storage attachment metadata objects ({ name, url, size, contentType })" },
        "hasChunkedContent": { "type": "boolean" },
        "chunkCount": { "type": "number" },
        "totalPayloadBytes": { "type": "number" },
        "price": { "type": "string", "maxLength": 50 },
        "startDate": { "type": "string", "maxLength": 100 },
        "expirationDate": { "type": "string", "maxLength": 100 },
        "eventDate": { "type": "string", "maxLength": 100 },
        "eventTime": { "type": "string", "maxLength": 50 },
        "ticketUrl": { "type": "string", "maxLength": 500 },
        "location": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["published", "osnutek", "pending", "rejected", "archived"] },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "likesCount": { "type": "number" },
        "likedBy": { "type": "array" },
        "viewsCount": { "type": "number" },
        "sharesCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "content", "category", "authorId", "authorName"]
    },
    "Ad": {
      "title": "Classified Ad",
      "description": "Mali oglas for goods, vehicles, real estate or services",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 3, "maxLength": 200 },
        "description": { "type": "string", "minLength": 5, "maxLength": 4500000 },
        "category": { "type": "string", "maxLength": 50 },
        "price": { "type": "string", "maxLength": 50 },
        "location": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 50 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorRole": { "type": "string", "maxLength": 50 },
        "imageUrl": { "type": "string", "maxLength": 4500000 },
        "images": { "type": "array" },
        "attachments": { "type": "array", "description": "Firebase Storage attachment metadata objects ({ name, url, size, contentType })" },
        "hasChunkedContent": { "type": "boolean" },
        "chunkCount": { "type": "number" },
        "totalPayloadBytes": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "sold", "closed", "pending", "rejected"] },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "likesCount": { "type": "number" },
        "likedBy": { "type": "array" },
        "viewsCount": { "type": "number" },
        "sharesCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "description", "category", "authorId", "authorName", "status"]
    },
    "Event": {
      "title": "Local Event or Concert",
      "description": "Event calendar entry in Portalko",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 3, "maxLength": 200 },
        "description": { "type": "string", "minLength": 5, "maxLength": 4500000 },
        "location": { "type": "string", "maxLength": 150 },
        "eventDate": { "type": "string", "maxLength": 100 },
        "eventTime": { "type": "string", "maxLength": 100 },
        "eventDates": { "type": "array" },
        "eventTimes": { "type": "array" },
        "eventSchedule": { "type": "array" },
        "ticketUrl": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 50 },
        "price": { "type": "string", "maxLength": 50 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorRole": { "type": "string", "maxLength": 50 },
        "imageUrl": { "type": "string", "maxLength": 4500000 },
        "images": { "type": "array" },
        "attachments": { "type": "array", "description": "Firebase Storage attachment metadata objects ({ name, url, size, contentType })" },
        "hasChunkedContent": { "type": "boolean" },
        "chunkCount": { "type": "number" },
        "totalPayloadBytes": { "type": "number" },
        "isPromoted": { "type": "boolean" },
        "status": { "type": "string", "enum": ["published", "pending", "rejected"] },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "likesCount": { "type": "number" },
        "likedBy": { "type": "array" },
        "viewsCount": { "type": "number" },
        "sharesCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "description", "location", "authorId", "authorName"]
    },
    "PayloadChunk": {
      "title": "Chunked Post/Ad/Event Payload Segment",
      "description": "Subdocument chunk storing overflow content/media for posts exceeding 700KB (supports up to 4.5MB total payload)",
      "type": "object",
      "properties": {
        "index": { "type": "number" },
        "data": { "type": "string", "maxLength": 900000 },
        "updatedAt": { "type": "string" }
      },
      "required": ["index", "data"]
    },
    "Like": {
      "title": "User Post Like",
      "description": "Like record on an individual post, ad, event or blog item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "targetId", "targetType"]
    },
    "Reaction": {
      "title": "User Post Reaction",
      "description": "Rich reaction record (like, love, dislike) on an individual post, ad, event or blog item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "maxLength": 50 },
        "reactionType": { "type": "string", "enum": ["like", "love", "dislike"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "targetId", "targetType", "reactionType"]
    },
    "Comment": {
      "title": "Post Comment",
      "description": "Public discussion comments on posts, ads, events, deals, and blog articles",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "maxLength": 50 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorAvatar": { "type": "string" },
        "authorRole": { "type": "string", "maxLength": 50 },
        "content": { "type": "string", "maxLength": 5000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "targetId", "targetType", "authorName", "content", "createdAt"]
    },
    "Bookmark": {
      "title": "User Bookmark",
      "description": "Saved post, ad, or event item for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "maxLength": 50 },
        "targetTitle": { "type": "string", "maxLength": 200 },
        "targetCategory": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "targetId", "targetType"]
    },
    "Follow": {
      "title": "Author Follow Subscription",
      "description": "Subscription record tracking a reader following a writer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "followerId": { "type": "string", "maxLength": 128 },
        "followerName": { "type": "string", "maxLength": 100 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorAvatar": { "type": "string", "maxLength": 500000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "followerId", "authorId", "authorName", "createdAt"]
    },
    "Category": {
      "title": "Category and Subcategories",
      "description": "Taxonomy category with subcategories for ads, events, blog and deals",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "section": { "type": "string", "enum": ["ads", "events", "blog", "deals"] },
        "icon": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 500 },
        "subcategories": { "type": "array" },
        "order": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "section"]
    },
    "Settings": {
      "title": "Portal System Settings",
      "description": "Global settings for portal including custom fallback image placeholder",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "fallbackImageUrl": { "type": "string" },
        "useFallbackForMissingImages": { "type": "boolean" },
        "useFallbackForBrokenImages": { "type": "boolean" },
        "pageSeo": { "type": "object", "description": "Custom per-page SEO titles, H1, H2, descriptions, and keywords" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id"]
    },
    "Banner": {
      "title": "Promotion Banner",
      "description": "Custom image banners or third party ad codes placed in sidebars and main container",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "position": { "type": "string", "enum": ["left_sidebar", "right_sidebar", "main_container"] },
        "type": { "type": "string", "enum": ["image", "code"] },
        "imageUrl": { "type": "string", "maxLength": 5000 },
        "targetUrl": { "type": "string", "maxLength": 2000 },
        "altText": { "type": "string", "maxLength": 500 },
        "caption": { "type": "string", "maxLength": 1000 },
        "openInNewTab": { "type": "boolean" },
        "customCode": { "type": "string", "maxLength": 50000 },
        "isActive": { "type": "boolean" },
        "order": { "type": "number" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "clicksCount": { "type": "number" },
        "viewsCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdById": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "title", "position", "type", "isActive"]
    },
    "ActivityLog": {
      "title": "Admin Activity Log",
      "description": "Audit trail log entries tracking actions performed by administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "adminId": { "type": "string", "maxLength": 128 },
        "adminName": { "type": "string", "maxLength": 100 },
        "adminEmail": { "type": "string", "maxLength": 120 },
        "adminRole": { "type": "string", "maxLength": 50 },
        "actionType": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 50 },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetTitle": { "type": "string", "maxLength": 200 },
        "details": { "type": "string", "maxLength": 5000 },
        "metadata": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "adminName", "actionType", "category", "details", "createdAt"]
    },
    "Notification": {
      "title": "User Notification",
      "description": "Real-time notification for post and comment replies, comments, and likes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderAvatar": { "type": "string", "maxLength": 500000 },
        "type": { "type": "string", "enum": ["comment", "reply", "like", "interaction", "system", "deal", "event", "ad"] },
        "title": { "type": "string", "maxLength": 200 },
        "body": { "type": "string", "maxLength": 1000 },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "maxLength": 50 },
        "postTitle": { "type": "string", "maxLength": 200 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["userId", "type", "title", "body"]
    },
    "ShareCount": {
      "title": "Content Share Counter",
      "description": "Persistent share count for news articles, blog posts, classified ads, events, and deals",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetId": { "type": "string", "maxLength": 256 },
        "targetType": { "type": "string", "enum": ["news", "blog", "post", "ad", "event", "deal"] },
        "sharesCount": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "targetId", "targetType", "sharesCount"]
    },
    "EventReminder": {
      "title": "User Event Reminder",
      "description": "Scheduled reminder for an individual event with lead time and notification trigger state",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "eventId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "eventTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "eventDate": { "type": "string", "minLength": 8, "maxLength": 32 },
        "eventTime": { "type": "string", "maxLength": 64 },
        "location": { "type": "string", "maxLength": 200 },
        "leadMinutes": { "type": "integer", "enum": [0, 15, 60, 1440] },
        "remindAt": { "type": "string", "minLength": 10, "maxLength": 64 },
        "triggered": { "type": "boolean" },
        "createdAt": { "type": "string", "minLength": 10, "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "eventId", "eventTitle", "eventDate", "leadMinutes", "remindAt", "triggered", "createdAt"]
    },
    "DirectoryCategory": {
      "title": "Directory Category",
      "description": "Category for Slovenian Web Directory (Imenik)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 500 },
        "order": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "name", "slug", "order", "createdAt"]
    },
    "DirectoryEntry": {
      "title": "Directory Entry",
      "description": "Single business or website entry in Imenik with rich text (H1-H3) and SEO/GEO metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 160 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "url": { "type": "string", "minLength": 4, "maxLength": 500 },
        "domain": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "richContent": { "type": "string", "maxLength": 1000000 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "categoryName": { "type": "string", "maxLength": 120 },
        "location": { "type": "string", "maxLength": 120 },
        "address": { "type": "string", "maxLength": 250 },
        "phone": { "type": "string", "maxLength": 80 },
        "email": { "type": "string", "maxLength": 120 },
        "workingHours": { "type": "string", "maxLength": 200 },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "tags": { "type": "array" },
        "seoTitle": { "type": "string", "maxLength": 160 },
        "metaDescription": { "type": "string", "maxLength": 320 },
        "focusKeyword": { "type": "string", "maxLength": 120 },
        "geoAreaServed": { "type": "string", "maxLength": 200 },
        "priceRange": { "type": "string", "maxLength": 20 },
        "foundingYear": { "type": "string", "maxLength": 20 },
        "faqItems": { "type": "array" },
        "status": { "type": "string", "enum": ["published", "pending", "rejected"] },
        "isSuggestion": { "type": "boolean" },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorRole": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "url", "domain", "description", "categoryId", "categoryName", "status", "isSuggestion", "authorId", "authorName", "authorRole", "createdAt"]
    },
    "DirectoryReview": {
      "title": "Directory Entry Review",
      "description": "User rating (1-5 stars) and review comment for a directory business",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "entryId": { "type": "string", "maxLength": 128 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorAvatar": { "type": "string", "maxLength": 500000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "entryId", "rating", "comment", "authorName", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles with role permissions"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Published community and blog posts"
    },
    "/posts/{postId}/chunks/{chunkId}": {
      "schema": "PayloadChunk",
      "description": "Chunked payload data for posts exceeding 700KB (up to 4.5MB total)"
    },
    "/ads/{adId}": {
      "schema": "Ad",
      "description": "Classified ads (mali oglasi)"
    },
    "/ads/{adId}/chunks/{chunkId}": {
      "schema": "PayloadChunk",
      "description": "Chunked payload data for classified ads exceeding 700KB (up to 4.5MB total)"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Events and concerts in the event calendar"
    },
    "/events/{eventId}/chunks/{chunkId}": {
      "schema": "PayloadChunk",
      "description": "Chunked payload data for events exceeding 700KB (up to 4.5MB total)"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Taxonomy categories and subcategories managed by admins"
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Global portal configurations and fallback image preferences"
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": "Bookmark",
      "description": "User specific bookmarks and saved items"
    },
    "/users/{userId}/likes/{likeId}": {
      "schema": "Like",
      "description": "User specific likes on posts, ads, events and blog"
    },
    "/users/{userId}/reactions/{reactionId}": {
      "schema": "Reaction",
      "description": "User specific reactions (like, love, dislike) on posts, ads, events and blog"
    },
    "/users/{userId}/notifications/{notifId}": {
      "schema": "Notification",
      "description": "User specific real-time notifications for post and comment replies, comments, and likes"
    },
    "/users/{userId}/following/{authorId}": {
      "schema": "Follow",
      "description": "Authors that a user subscribes to and follows"
    },
    "/users/{userId}/event_reminders/{reminderId}": {
      "schema": "EventReminder",
      "description": "User scheduled reminders for individual events"
    },
    "/author_followers/{authorId}/followers/{followerId}": {
      "schema": "Follow",
      "description": "Subscribers following a specific writer for public follower counts"
    },
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "Public user discussion comments across all post types"
    },
    "/banners/{bannerId}": {
      "schema": "Banner",
      "description": "Promotion banners and third-party code ads placed in left sidebar, right sidebar, and main container"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Audit trail log entries tracking actions performed by administrators"
    },
    "/share_counts/{targetKey}": {
      "schema": "ShareCount",
      "description": "Public share counters for news items and blog/community posts"
    },
    "/directory_categories/{categoryId}": {
      "schema": "DirectoryCategory",
      "description": "Slovenian Web Directory (Imenik) categories managed by admins"
    },
    "/directory_entries/{entryId}": {
      "schema": "DirectoryEntry",
      "description": "Slovenian Web Directory (Imenik) single entries with rich text and SEO/GEO metadata"
    },
    "/directory_entries/{entryId}/reviews/{reviewId}": {
      "schema": "DirectoryReview",
      "description": "5-star user ratings and comments for individual Imenik directory entries"
    }
  }
}
