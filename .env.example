# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: Google OAuth 2.0 Client ID for Google Identity Services / Sign in with Google
VITE_GOOGLE_CLIENT_ID=

# VITE_FIREBASE_API_KEY: Public Firebase browser key. Restrict it to approved
# domains and APIs in Google Cloud Console before adding it to Netlify.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# STRIPE_SECRET_KEY: Secret key for Stripe payment processing (server-side only)
STRIPE_SECRET_KEY=

# VITE_STRIPE_PUBLISHABLE_KEY: Publishable key for Stripe Elements (client-side)
VITE_STRIPE_PUBLISHABLE_KEY=

# Email Dispatch Configuration for noreply@portalko.net (Noreply Confirmation Emails):
# Option A: Brevo / Sendinblue API (https://brevo.com - 300 free emails/day, EU GDPR compliant, REST API HTTPS port 443, never blocked by SMTP country filters)
BREVO_API_KEY=

# Option B: Resend API (https://resend.com - modern serverless REST API HTTPS)
RESEND_API_KEY=

# Option C: SendGrid API
SENDGRID_API_KEY=

# Option D: Standard SMTP configuration (Hitrost, cPanel, Hostinger, Mailgun, Google Workspace, etc.)
# Note for Hitrost.net / cPanel: Ensure "Državna zaščita" (Country filter) in cPanel does not block foreign IP addresses from cloud hosts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOREPLY_EMAIL="noreply@portalko.net"
NOREPLY_NAME="Portalko.net"
